# ===========================================
# LIVECART FRONTEND - Environment Variables
# ===========================================

# -------------------------------------------
# Clerk Authentication (OBRIGATORIO)
# Obtenha em: Clerk Dashboard → API Keys
# -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# -------------------------------------------
# Clerk URLs (pre-configurado)
# -------------------------------------------
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# -------------------------------------------
# API Backend
# -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# -------------------------------------------
# Pagar.me Hub (Partner App — install/OAuth flow)
# -------------------------------------------
# publicAppKey (UUID) do app parceiro no Pagar.me Hub. Valor publico, usado
# para montar a URL de autorizacao do botao. Sem ele, o Pagar.me cai no fluxo
# manual de chaves sk_/pk_.
NEXT_PUBLIC_PAGARME_APP_PUBLIC_KEY=
# Ambiente do Hub. "production" (default) usa a URL de producao; qualquer valor
# comecando com "dev" (ex.: "dev", "development") aponta para o ambiente de
# desenvolvimento do Hub. Espelha o widget oficial mundipagg/hub-button.
NEXT_PUBLIC_PAGARME_HUB_ENV=production

# -------------------------------------------
# E2E Testing (Playwright + Clerk)
# Credenciais de um usuario de teste no Clerk
# -------------------------------------------
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
E2E_BASE_URL=http://localhost:3000

# Modo escuro (opt-in por ambiente): "true" habilita o toggle de tema.
# dev local e staging usam "true"; producao NAO seta (light garantido).
NEXT_PUBLIC_DARK_THEME_ENABLED=true
