# ===========================================
# LIVECART FRONTEND - Environment Variables
# ===========================================

# -------------------------------------------
# Clerk Authentication (OBRIGATORIO)
# Obtenha em: Clerk Dashboard → API Keys
# -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# -------------------------------------------
# Clerk URLs (pre-configurado)
# -------------------------------------------
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# -------------------------------------------
# API Backend
# -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# -------------------------------------------
# E2E Testing (Playwright + Clerk)
# Credenciais de um usuario de teste no Clerk
# -------------------------------------------
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
E2E_BASE_URL=http://localhost:3000
